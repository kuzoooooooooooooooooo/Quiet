{
  "name": "Quiet Workspace",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": { "ghcr.io/devcontainers/features/node:1": { "version": "24" } },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [1420],
  "portsAttributes": {
    "1420": {
      "label": "Quiet · browser preview",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": { "extensions": ["rust-lang.rust-analyzer", "tauri-apps.tauri-vscode"] }
  }
}

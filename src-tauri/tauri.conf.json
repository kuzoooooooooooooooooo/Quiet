{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quiet",
  "version": "0.9.0",
  "identifier": "app.quiet.workspace",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quiet — Workspace",
        "width": 1280,
        "height": 850,
        "minWidth": 680,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'self' blob:; worker-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4QUZDNEFEQzZENjMxQkQKUldTOU1kYkdyY1N2U0xuZHJlNzdkRzg2Zm5pMk5jYUhXYlQ4QkZUVHR3WGROM1hSREdmcVR2eGMK",
      "endpoints": [
        "https://github.com/kuzoooooooooooooooooo/Quiet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
